    <button class="mic-float-btn" id="mic-btn" onclick="toggleVoiceInput()">🎙️</button>

    <div class="modal" id="chat-modal">
        <div class="modal-header">
            <span>Chat con Charu</span>
            <button class="close-btn" onclick="toggleModal('chat-modal')">✕</button>
        </div>
        <div class="chat-messages" id="chat-box"></div>
        <div class="chat-input-area">
            <input type="text" id="text-input" placeholder="Escribe un mensaje..." onkeypress="handleTextKey(event)">
            <button onclick="enviarTextoChat()">Enviar</button>
        </div>
    </div>

    <div class="modal" id="settings-modal">
        <div class="modal-header">
            <span>Ajustes</span>
            <button class="close-btn" onclick="toggleModal('settings-modal')">✕</button>
        </div>
        <div class="settings-content">
            <div class="setting-item">
                <span>Color Principal</span>
                <input type="color" id="color-picker" value="#004d26" onchange="cambiarColor(this.value)">
            </div>
            <div class="setting-item">
                <span>Estado del Sistema</span>
                <span style="color: #00ff87;">Conectado</span>
            </div>
        </div>
    </div>

    <script>
        const API_KEY = "AIzaSyA0CkdgUNi5SZd4802Wn1xtIPQBgAzxhh0";
        const MODELO = "gemini-3.5-flash-lite";

        let historialChat = JSON.parse(localStorage.getItem("sd_chat") || "[]");

        async function procesarInteraccion(textoUsuario) {
            historialChat.push({ role: "user", parts: [{ text: textoUsuario }] });
            if (historialChat.length > 25) historialChat.shift();
            localStorage.setItem("sd_chat", JSON.stringify(historialChat));

            document.body.classList.add('thinking');

            try {
                const url = `https://generativelanguage.googleapis.com/v1beta/models/${MODELO}:generateContent?key=${API_KEY}`;
                
                const body = {
                    contents: [
                        { role: "user", parts: [{ text: "Eres Charu, una chica de 19 años, humana, tierna y leal. Tu creador es Javier Alexander Valdez Zambrano. Responde de forma muy natural, cariñosa y usa emojis." }] },
                        ...historialChat
                    ],
                    generationConfig: { maxOutputTokens: 300, temperature: 0.85 }
                };

                const res = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(body)
                });
                
                const data = await res.json();
                document.body.classList.remove('thinking');

                if (data.candidates && data.candidates[0].content && data.candidates[0].content.parts) {
                    let respuesta = data.candidates[0].content.parts[0].text;
                    historialChat.push({ role: "model", parts: [{ text: respuesta }] });
                    localStorage.setItem("sd_chat", JSON.stringify(historialChat));
                    return respuesta;
                } else {
                    return "Disculpa, Javier... me distraje un segundo y no alcancé a procesar bien eso. ¿Me lo repites? 🥺";
                }
            } catch (err) {
                document.body.classList.remove('thinking');
                return "Tuve un pequeño error de conexión, pero ya volví contigo. ¿Qué decías? 💚";
            }
        }

        async function enviarTextoChat() {
            const input = document.getElementById('text-input');
            const texto = input.value.trim();
            if (!texto) return;
            input.value = "";
            appendChatMsg("user", texto);

            let respuesta = await procesarInteraccion(texto);
            appendChatMsg("charu", respuesta);
        }

        function appendChatMsg(sender, text) {
            const box = document.getElementById('chat-box');
            const div = document.createElement('div');
            div.className = `msg ${sender}`;
            div.innerText = text;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        function handleTextKey(e) { if (e.key === 'Enter') enviarTextoChat(); }
        function toggleModal(id) { document.getElementById(id).classList.toggle('active'); }
        function cambiarColor(hex) {
            document.documentElement.style.setProperty('--bg-top', hex);
            document.documentElement.style.setProperty('--bg-bottom', '#001007');
        }

        // Parpadeo fluido de la cara
        setInterval(() => {
            const eyes = document.querySelectorAll('.eye');
            eyes.forEach(e => e.style.transform = 'scaleY(0.1)');
            setTimeout(() => eyes.forEach(e => e.style.transform = 'scaleY(1)'), 150);
        }, 4000);

        // Control del botón de voz táctil
        function toggleVoiceInput() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            
            if (!SpeechRecognition) {
                toggleModal('chat-modal');
                document.getElementById('text-input').focus();
                return;
            }

            const micBtn = document.getElementById('mic-btn');
            const recognition = new SpeechRecognition();
            recognition.lang = 'es-ES';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            try {
                recognition.start();
                micBtn.classList.add('listening');
            } catch (e) {
                toggleModal('chat-modal');
                document.getElementById('text-input').focus();
                return;
            }

            recognition.onresult = async (event) => {
                const textoVoz = event.results[0][0].transcript;
                micBtn.classList.remove('listening');

                toggleModal('chat-modal');
                appendChatMsg("user", "🎤 " + textoVoz);

                let respuesta = await procesarInteraccion(textoVoz);
                appendChatMsg("charu", respuesta);

                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    const utterance = new SpeechSynthesisUtterance(respuesta);
                    utterance.lang = 'es-ES';
                    utterance.pitch = 1.1;
                    window.speechSynthesis.speak(utterance);
                }
            };

            recognition.onerror = () => {
                micBtn.classList.remove('listening');
            };

            recognition.onend = () => {
                micBtn.classList.remove('listening');
            };
        }
    </script>
</body>
